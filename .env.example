# Ollama Server Configuration
OLLAMA_HOST=http://localhost:11434

# Model Configuration
# Recommended default with tool-calling support: llama3.1:8b or qwen2.5:7b
# Lightweight alternatives for CPU-only laptops: llama3.2:3b, qwen2.5:3b
MODEL_NAME=llama3.1:8b

# LLM Generation Parameters
TEMPERATURE=0.2

# Reliability & Safety Limits
REQUEST_TIMEOUT=120
MAX_TOOL_CALLS=3
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
